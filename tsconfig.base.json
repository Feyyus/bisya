{
    "compilerOptions": {
        "target": "ES2022",
        "lib": [
            "ES2022"
        ],
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "strict": true,
        "declaration": true,
        "composite": true,
        "skipLibCheck": true,
        "sourceMap": true,
        "types": [
            "node"
        ],
        "baseUrl": ".",
        "rootDir": ".",
        "outDir": "dist",
        "paths": {
            "@bisya/db": [
                "packages/db/src/index.ts"
            ],
            "@bisya/wallet": [
                "packages/wallet/src/index.ts"
            ],
            "@bisya/scheduler": [
                "packages/scheduler/src/index.ts"
            ],
            "@bisya/bot-kit": [
                "packages/bot-kit/src/index.ts"
            ]
        }
    },
    "exclude": [
        "dist",
        "node_modules"
    ]
}